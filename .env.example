# Supabase — clés publiques (Data API / client)
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Postgres du même projet (Prisma). Dashboard → Connect → Prisma.
# Le pooler (6543) sert à l'app ; la connexion directe (5432) sert à prisma db push.
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Secret pour les sessions JWT (générer une clé aléatoire en prod)
AUTH_SECRET="changez-moi-en-production-avec-une-cle-secrete-longue"

# Chargily Pay — CCP Algérie uniquement (EDAHABIA)
# https://pay.chargily.com — clé secrète test_sk_… ou live_sk_…
CHARGILY_SECRET_KEY=""
CHARGILY_MODE="test"

# CinetPay — cartes Visa/Mastercard des banques d'Afrique subsaharienne
# https://cinetpay.com — pas les cartes CIB algériennes
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_CURRENCY="XAF"

# URL de l'application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret serveur des webhooks de paiement. Doit correspondre à private.internal_secrets.
FULFILLMENT_SECRET=""
